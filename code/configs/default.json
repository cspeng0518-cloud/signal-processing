{
  "model": {
    "d_model": 512,
    "n_layers": 24,
    "nhead": 8,
    "ffn_hidden": 2048,
    "layer_types": ["full_attention", "mla", "mla"],
    "mla_kv_lora_rank": 128,
    "mla_q_lora_rank": 128,
    "dropout": 0.1,
    "drop_path": 0.1,
    "grad_checkpoint": false,

    "neck_layers": 2,
    "neck_layer_types": ["conformer"],
    "neck_with_freq": true,
    "neck_drop_path": 0.1,
    "conv_kernel": 15,

    "seq_len": 1024,
    "patch_size": 8,
    "length_quantum": 512,
    "trim_padding": true,
    "dft_impl": "matmul",
    "stem_width": 64,
    "stft_win": 32,
    "use_stft": true,
    "use_stats": true,
    "use_spec": true,
    "use_acf": true,
    "use_const": true,
    "spec_tokens": 32,
    "acf_tokens": 16,
    "const_bins": 32,
    "const_patch": 8,
    "freq_layers": 2,
    "task_prompt": true,

    "mask_ratio": 0.75,
    "mae_decoder_dim": 256,
    "mae_decoder_layers": 2,
    "stft_loss_weight": 0.5,

    "pool_heads": 4,
    "head_config": {
      "protocol":   {"hidden": 512, "layers": 1},
      "modulation": {"hidden": 768, "layers": 2},
      "parameter":  {"hidden": 768, "layers": 2}
    },
    "mod_family_aux": true,
    "supcon_dim": 128
  },
  "training": {
    "seq_len": 1024,
    "batch_size": 256,
    "batch_size_pretrain": 512,
    "eval_batch_size": 1024,
    "lr": 0.0002,
    "lr_pretrain": 0.0003,
    "lr_finetune": 0.0002,
    "weight_decay": 0.05,
    "betas": [0.9, 0.95],
    "optimizer": "adamw",
    "warmup_steps": 0,
    "warmup_ratio": 0.05,
    "min_lr_ratio": 0.05,
    "grad_clip": 1.0,
    "amp": true,
    "seed": 42,
    "num_workers": 8,
    "length_bucketing": true,
    "log_every": 50,

    "epochs_pretrain": 100,
    "steps_per_epoch_pretrain": 0,
    "val_batches_pretrain": 40,
    "patience_pretrain": 5,
    "min_delta_pretrain": 0.001,

    "epochs_finetune": 100,
    "steps_per_epoch": 0,
    "eval_every": 1,
    "patience": 8,
    "min_delta": 0.0001,
    "ema_decay": 0.999,

    "augment": true,
    "task_weighting": "fixed",
    "task_weights": {"protocol": 0.5, "modulation": 1.0, "parameter": 1.0},
    "pcgrad": false,
    "label_smoothing": {"protocol": 0.05, "modulation": 0.1},
    "family_loss_weight": 0.2,
    "supcon_weight": {"modulation": 0.1},
    "supcon_temperature": 0.07,
    "param_loss": "huber",
    "pattern_loss_weight": 0.3,
    "codec": {"max_classes": 32, "decode": "expectation"},
    "score_weights": {"protocol": 0.3, "modulation": 0.3, "parameter": 0.4},
    "ref_scale": 0.5
  },
  "operator": {
    "attention":   true,
    "swiglu":      false,
    "rmsnorm":     false,
    "rmsnorm_add": false,
    "rope_rotate": false,
    "mla_preprocess": false
  }
}
